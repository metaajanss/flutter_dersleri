{
  "manifest_version": 3,
  "name": "Facebook Ads Library Reklam Veren Çekici",
  "version": "1.0.0",
  "description": "Facebook Ads Library sayfasında aşağı kaydırdıkça yüklenen reklamlardan reklam veren bilgilerini toplar ve Excel (.xlsx) olarak dışa aktarır.",
  "default_locale": "tr",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting", "downloads", "tabs"],
  "host_permissions": ["https://www.facebook.com/ads/library/*"],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/ads/library/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
